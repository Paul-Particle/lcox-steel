configfile: "config/config.yaml"


from pathlib import Path

# VM workaround: strip NUL bytes that occasionally corrupt source files.
# The VM filesystem can write trailing NUL padding on flush; this scrubs them
# from Python scripts, Snakemake rules files, and the Snakefile itself so that
# git always sees clean text objects.
onstart:
    _smk_root = Path(workflow.basedir)
    _targets = list(_smk_root.glob("scripts/**/*.py")) + \
               list(_smk_root.glob("rules/**/*.smk")) + \
               [_smk_root / "Snakefile"]
    for p in _targets:
        if not p.exists():
            continue
        data = p.read_bytes()
        if b'\x00' in data:
            p.write_bytes(data.replace(b'\x00', b''))
            print(f"VM workaround: Removed NUL bytes from {p.relative_to(_smk_root)}")

import pandas as pd

# One row per input series of a run, from the scenario table config.yaml names
# under `inputs` (the generated one by default, the demo's with
# `--configfile config/demo.yaml`).
scenarios_df = pd.read_csv(config["inputs"]["scenarios"], comment="#", dtype=str)

# One row per run: a scenario is one run, or one per market zone.
runs_df = scenarios_df.drop_duplicates(["scenario", "run"])
SCENARIOS = runs_df["scenario"].unique()

# The areas the geometry rules build: every registered area except the demo's,
# whose land and offshore geometry ship with the repository so the demo runs
# without the Natural Earth and EEZ zips. A sub-national area (one that lists
# `admin1_names`) takes its offshore geometry from make_zone_offshore_geometry,
# a country from make_offshore_geometry.
areas_df = pd.DataFrame.from_dict(config["areas"], orient="index")
built_df = areas_df.query("demo != True")
BUILT_AREAS = "|".join(built_df.index)
SUBNATIONAL_AREAS = "|".join(built_df.dropna(subset=["admin1_names"]).index)
COUNTRY_AREAS = "|".join(built_df.index.difference(built_df.dropna(subset=["admin1_names"]).index))


include: "rules/_optional_shim.smk"
include: "rules/grid.smk"
include: "rules/res_cf.smk"
include: "rules/solve.smk"
include: "rules/viz.smk"


# Default target: every scenario of the scenario table. The default table is
# the one generated from the input workbook; `--configfile config/demo.yaml`
# selects the template's instead, a small self-contained demo that runs after a
# fresh clone with no CDS download, no EEZ/NE zips and no API keys. It ships a
# pre-sliced Victoria (AUS) cutout for the DEMO area and its geo parquets, and
# melts its export twins' iron in ES_SYN, a made-up Spain-like market.
rule all:
    default_target: True
    input:
        collect("results/{scenario}/report_{scenario}.csv", scenario=SCENARIOS),
