configfile: "config/config.yaml"


from pathlib import Path

# VM workaround: strip NUL bytes that occasionally corrupt source files.
# The VM filesystem can write trailing NUL padding on flush; this scrubs them
# from Python scripts, Snakemake rules files, and the Snakefile itself so that
# git always sees clean text objects.
onstart:
    _smk_root = Path(workflow.basedir)
    _targets = list(_smk_root.glob("scripts/**/*.py")) + \
               list(_smk_root.glob("rules/**/*.smk")) + \
               [_smk_root / "Snakefile"]
    for p in _targets:
        if not p.exists():
            continue
        data = p.read_bytes()
        if b'\x00' in data:
            p.write_bytes(data.replace(b'\x00', b''))
            print(f"VM workaround: Removed NUL bytes from {p.relative_to(_smk_root)}")

from common._runs import (
    ROUTE_PATTERN,
    build_destination_frame,
    build_runs_frame,
    load_scenarios,
    top_level_areas,
)

# One row per input timeseries, validated, with `all-areas` cells resolved
# against the area registry — so every row downstream, the solve rule's lookup
# included, names one real area.
scenarios_df = load_scenarios("config/scenarios.csv", config["areas"])

# One row per network to solve — `all-routes` and `a|b` cells expanded.
runs_df = build_runs_frame(scenarios_df, config["areas"])

# One row per `-export` run, naming the market its furnace stands in, so the
# solve and report rules can ask for that market's series. A scenario's overlay
# may move it, as the demo's does.
destinations_df = build_destination_frame(runs_df, Path("config"), config["areas"])

# The areas make_area_geometry can build. It reads Natural Earth Admin 0, which
# is countries only, so a zone's geometry is a committed source file instead
# (issue #64) — constraining the rule keeps it from claiming one and rebuilding
# it as the whole country the next time the Admin 0 zip looks newer.
COUNTRY_AREAS = "|".join(top_level_areas(config["areas"]))

SCENARIOS = scenarios_df["scenario"].unique()
# A scenario name is a free-form label — nothing here reads meaning out of it,
# so the demo set is listed in config.yaml rather than matched on a prefix.
DEMO_SCENARIOS = config["demo_scenarios"]


include: "rules/_optional_shim.smk"
include: "rules/grid.smk"
include: "rules/res_cf.smk"
include: "rules/solve.smk"
include: "rules/viz.smk"


# Default target: a small, self-contained demo that runs after a fresh clone
# with no CDS download, no EEZ/NE zips, and no API keys. It ships a pre-sliced
# Victoria (AUS) cutout for the DEMO area + its geo parquets, melts its export
# twins' iron in ES_SYN, a made-up Spain-like market, and exercises the
# best-site and anchor-colocation (multi-site PyPSA) RES-CF science through to
# a solve and a viz report. Run the full set with `snakemake all`.
rule demo:
    default_target: True
    input:
        collect("results/{scenario}/report_{scenario}.csv", scenario=DEMO_SCENARIOS),
        collect("results/{scenario}/plots/capacity_bars.png", scenario=DEMO_SCENARIOS),


rule all:
    input:
        # One report per scenario — its rows are that scenario's runs.
        collect("results/{scenario}/report_{scenario}.csv", scenario=SCENARIOS),
        # One comparison bar chart per scenario.
        collect("results/{scenario}/plots/capacity_bars.png", scenario=SCENARIOS),
