# Operating System Files
.DS_Store
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
*.env
.env

# Data files (broad patterns cover resources/ and other locations)
*.parquet
*.feather
!config/scenarios.csv

# Cache directories: ignore everything except the committed reference file in each
data/nem_cache/*
!data/nem_cache/NEM Registration and Exemption List.xlsx
data/entsoe_cache/*
!data/entsoe_cache/entsoe_bidding_zones.csv
data/canada_cache/*
data/ons_cache/*
data/canada_cache/*

# Derived workflow outputs (rebuilt by snakemake), except the area geometries,
# which are committed: building them needs the EEZ and Natural-Earth zips the
# repo does not ship, and the demo has to run after a fresh clone.
resources/*.parquet
# Contents rather than the directory, because git will not descend into an
# excluded directory and a re-include below it never fires.
resources/timeseries/*
# The one series the demo needs: its export twins melt iron in Spain, so they
# price a destination market, and shipping it keeps the default target runnable
# without an ENTSO-E key.
!resources/timeseries/ESP_grid_emissions_20250101_20251231.parquet
resources/shapes/
!resources/shapes/*.parquet

# Log files
logs/

# Snakemake
.snakemake/
.snakemake_profile/
.snakemake_log/

# Generated results
results/*.html
results/*.png
results/*.svg
results/*.json

# IDE specific files
.vscode/
*.swp
.antigravitycli
.claude

# Git attributes
* text=auto eol=lf

# Atlite / ERA5. The demo's pre-sliced Victoria cutout is committed so that a
# fresh clone runs with no CDS download; `cutouts/*` rather than `cutouts/` so
# that one file can be excepted, and the exception comes after `*.nc`.
cutouts/*
*.nc
!cutouts/VIC1_20250101_20251231_backup.nc

# Raw/large geodata (download manually — see README)
data/shapes/offshore_zones/
data/shapes/ne_110m_admin_0_countries/
data/shapes/ne_10m_admin_1_states_provinces/
data/shapes/ne_10m_land/
data/shapes/*.zip

# Local virtualenv (Atlite)
.venv-atlite/

# Atlite scratch (working dir)
.atlite-cache/

# Model outputs
results/
results.zip

# other
.snakemake
WALKTHROUGH.md
.mcp.json
